# Geliştirme ortamı için hazır ayarlar. Kullanmak için: cp .env.example .env.local
# Bu dosya git'e girer, içindekiler herkes tarafından bilinir: gerçek sunucuda bu değerleri KULLANMAYIN.

# docker-compose.yml'deki Postgres bilgileriyle aynı
DATABASE_URL=postgresql://voting-authority:postgres@localhost:5432/postgres

# Oturum cookie'lerini imzalayan sunucu anahtarı. Geliştirmede bu değer yeterli.
# Gerçek sunucuda rastgele üret: node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
SESSION_SECRET=gelistirme-icin-sabit-anahtar-gercek-sunucuda-degistir

# Postgres container'ının ayarları. docker-compose.yml'deki değerlerle ve DATABASE_URL ile aynı olmalı.

# Veritabanı kullanıcı adı
POSTGRES_USER=voting-authority

# Veritabanı kullanıcısının şifresi
POSTGRES_PASSWORD=postgres

# Oluşturulacak veritabanının adı
POSTGRES_DB=postgres
